# Copy to .env and change every secret before deployment.
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
COOKIE_SECURE=false
# First administrator is created only if no admin exists.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=CHANGE_THIS_FIRST_LOGIN
