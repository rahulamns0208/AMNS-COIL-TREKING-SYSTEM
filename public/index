<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>AM/NS India Pune - Yard & Transfer Assurance System</title>
<style>
:root{--amns-red:#E30613;--amns-dark:#1F252B;--amns-light:#F4F6F8;--amns-gray:#6C757D;--amns-white:#fff;--green:#28A745;--blue:#007BFF;--purple:#6F42C1;--orange:#FD7E14}
*{box-sizing:border-box;margin:0;padding:0;font-family:'Segoe UI',Tahoma,Geneva,Verdana,sans-serif}body{background:var(--amns-light);color:var(--amns-dark);min-height:100vh}.hidden{display:none!important}
header{background:#fff;border-bottom:4px solid var(--amns-red);padding:12px 24px;display:flex;justify-content:space-between;align-items:center;gap:12px;box-shadow:0 2px 8px #0001}.brand{display:flex;align-items:center;gap:10px}.logo{background:var(--amns-red);color:white;font-weight:900;padding:6px 14px;font-size:20px;border-radius:4px}.title{font-size:18px;font-weight:bold}.subtitle{font-size:12px;color:var(--amns-gray)}.actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.btn{border:0;border-radius:4px;padding:8px 12px;color:white;font-weight:bold;cursor:pointer}.red{background:var(--amns-red)}.dark{background:var(--amns-dark)}.green{background:var(--green)}.blue{background:var(--blue)}.purple{background:var(--purple)}.gray{background:var(--amns-gray)}button:disabled{opacity:.5;cursor:not-allowed}
.user-badge{background:var(--amns-light);padding:6px 10px;border-radius:20px;border:1px solid #ddd;font-size:12px;font-weight:bold}.search{background:var(--amns-dark);color:#fff;padding:10px 24px;display:flex;gap:10px;align-items:center;flex-wrap:wrap}.search input{width:min(320px,100%)}input,select,textarea{padding:8px;border:1px solid #ced4da;border-radius:4px;font-size:13px;min-width:0}main{padding:15px;display:grid;grid-template-columns:minmax(0,1fr);gap:15px}.panel{background:#fff;border-radius:8px;padding:15px;box-shadow:0 2px 10px #0000000d;margin-bottom:15px}.panel-head{border-bottom:2px solid var(--amns-light);padding-bottom:8px;margin-bottom:12px;font-size:15px;font-weight:bold;color:var(--amns-red);display:flex;justify-content:space-between;align-items:center;gap:8px}.grid2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:15px}.field{display:flex;flex-direction:column;gap:4px;margin-bottom:10px}.field label{font-size:12px;font-weight:bold}.field input,.field select,.field textarea{width:100%}.row{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.row>*{flex:1}.yard-tabs{display:flex;gap:7px;overflow-x:auto;margin-bottom:10px}.yard-tab{padding:6px 12px;background:var(--amns-light);border:1px solid #dee2e6;border-radius:4px;cursor:pointer;font-size:11px;font-weight:bold;white-space:nowrap}.yard-tab.active{background:var(--amns-dark);color:white}.layers{display:flex;gap:8px;background:#e9ecef;padding:8px;border-radius:6px;margin-bottom:12px;align-items:center;flex-wrap:wrap}.layer-btn{padding:6px 9px;border:1px solid #ccc;background:white;border-radius:4px;font-size:11px;font-weight:bold;cursor:pointer}.layer-btn.active{background:var(--amns-dark);color:white}.yard-grid{display:grid;grid-template-columns:28px repeat(5,minmax(0,1fr));gap:5px;background:#e9ecef;padding:8px;border-radius:6px}.grid-header,.row-label{background:var(--amns-dark);color:#fff;text-align:center;padding:5px 0;font-weight:bold;font-size:11px;border-radius:3px}.cell{background:white;border:1px dashed #b0bec5;min-height:65px;border-radius:4px;padding:4px;display:flex;flex-direction:column;justify-content:space-between;cursor:pointer;overflow:hidden}.cell.occupied{background:#e3f2fd;border:1.5px solid var(--blue)}.cell-content{font-size:10px;font-weight:bold;text-align:center;overflow-wrap:anywhere}.cell-id{font-size:9px;color:var(--amns-gray);font-weight:bold}.muted{color:#777;font-size:12px}.cards{display:grid;gap:8px}.task{border-left:5px solid var(--amns-red);background:#fff5f5;padding:12px;border-radius:4px;display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap}.task strong{color:var(--amns-red)}table{width:100%;border-collapse:collapse;font-size:12px}th,td{border-bottom:1px solid #e5e5e5;text-align:left;padding:8px;overflow-wrap:anywhere}th{background:var(--amns-dark);color:white;position:sticky;top:0}.table-wrap{overflow:auto;max-height:420px}.pill{display:inline-block;background:#e9ecef;border-radius:12px;padding:3px 8px;font-size:11px}.notice{padding:10px;border-radius:5px;background:#fff3cd;color:#664d03;font-size:12px;margin-bottom:10px}.login-overlay{position:fixed;inset:0;background:#1f252bf2;z-index:1000;display:flex;justify-content:center;align-items:center;padding:15px}.login-card{background:white;border-top:5px solid var(--amns-red);border-radius:8px;padding:28px;width:360px;max-width:100%;box-shadow:0 4px 20px #0004}.login-card h2{color:var(--amns-red);text-align:center;margin:10px 0 4px}.login-card p{text-align:center;color:var(--amns-gray);font-size:12px;margin-bottom:16px}.status{color:#ffd700;font-size:13px;font-weight:bold}.modal{position:fixed;inset:0;background:#0009;z-index:900;display:flex;align-items:center;justify-content:center;padding:15px}.modal-card{background:white;border-top:5px solid var(--blue);border-radius:8px;padding:18px;width:650px;max-width:100%;max-height:90vh;overflow:auto}.small{font-size:11px;color:var(--amns-gray)}@media(max-width:850px){header{align-items:flex-start;flex-direction:column}.grid2{grid-template-columns:1fr}.search{padding:10px}.yard-grid{gap:3px;padding:4px}.cell{min-height:58px;padding:2px}.panel{padding:10px}main{padding:8px}}
</style></head>
<body>
<div id="login-overlay" class="login-overlay"><div class="login-card">
<div class="logo" style="width:fit-content;margin:auto">AM/NS</div><h2>PUNE FACILITY</h2><p>Coil Tracking Management System</p>
<form id="login-form"><div class="field"><label>Username</label><input id="login-username" autocomplete="username" required></div><div class="field"><label>Password</label><input id="login-password" type="password" autocomplete="current-password" required></div><button class="btn red" style="width:100%">Login</button><p id="login-error" style="color:#c00;margin-top:10px"></p><div class="small">Individual accounts are created by the system administrator. Demo shared passwords have been removed.</div></form>
</div></div>
<header><div class="brand"><div class="logo">AM/NS</div><div><div class="title">AM/NS INDIA - PUNE FACILITY</div><div class="subtitle">Online Exit Saddle, Yard Map & Return Assurance System</div></div></div><div class="actions"><span class="user-badge" id="whoami">Not Logged In</span><button class="btn dark" id="btn-history">Movement History</button><button class="btn green" id="btn-export">Download Excel</button><button class="btn red" id="btn-logout">Logout</button></div></header>
<div class="search"><label for="search-coil">Global Coil Search:</label><input id="search-coil" placeholder="Enter registered coil number"><button class="btn red" id="btn-search">Search</button><span id="search-result" class="status"></span></div>
<main>
<div class="notice">Live-data mode: no sample coil numbers or prefilled locations are loaded. Data is stored on the server database. Camera tracking is not active because no camera has been installed.</div>
<div class="grid2">
<section class="panel"><div class="panel-head">Coil Registration / Details</div><form id="coil-form"><div class="field"><label>Coil Number</label><input id="coil-no" required placeholder="Enter actual coil number"></div><div class="field"><label>Current Area / Department</label><select id="coil-area"><option value="">Select area (optional)</option></select></div><div class="field"><label>Current Location / Cell</label><input id="coil-location" placeholder="Enter actual location, e.g. A1"></div><div class="field"><label>Notes</label><textarea id="coil-notes" rows="2"></textarea></div><button class="btn red">Register Coil</button></form></section>
<section class="panel"><div class="panel-head">Entry Line Coil Request</div><form id="transfer-form"><div class="field"><label>Coil Number Required</label><input id="req-coil" required placeholder="Registered coil number"></div><div class="field"><label>Target Entry Line Area</label><select id="req-destination" required></select></div><button class="btn red">Dispatch Request to Crane</button></form><div class="small">Only registered coils at known locations can be requested.</div></section>
</div>
<div class="grid2">
<section class="panel"><div class="panel-head">Exit Saddles — Live Positions</div><div class="field"><label>Exit Line Area</label><select id="saddle-dept"></select></div><div id="saddle-slots" class="grid2"></div></section>
<section class="panel"><div class="panel-head">Transfer Requests & Return Assurance</div><div id="transfer-list" class="cards"><p class="muted">Loading live requests…</p></div></section>
</div>
<section class="panel"><div class="panel-head">Storage Yard Layout Grid Map <span class="pill" id="yard-count">0 registered in yard</span></div><div class="yard-tabs" id="yard-tabs"></div><div class="layers"><strong style="font-size:11px">Map View Layer Filter:</strong><button class="layer-btn active" data-layer="ALL">ALL LAYERS</button><button class="layer-btn" data-layer="1">L1 MAP</button><button class="layer-btn" data-layer="2">L2 MAP</button><button class="layer-btn" data-layer="3">L3 MAP</button></div><div id="yard-grid" class="yard-grid"></div><p class="small" style="margin-top:8px">Select a cell to assign an already registered coil to that location. This interface does not detect physical crane position.</p></section>
<section class="panel"><div class="panel-head">Current Coil Inventory <span class="pill" id="coil-count">0 coils</span></div><div class="table-wrap"><table><thead><tr><th>Coil Number</th><th>Area</th><th>Location</th><th>Layer</th><th>Status</th><th>Last Updated</th><th>Action</th></tr></thead><tbody id="inventory-body"><tr><td colspan="7">Loading…</td></tr></tbody></table></div></section>
<section class="panel hidden" id="admin-panel"><div class="panel-head">User & Permission Administration</div><div class="notice">Create separate accounts for each crane and department. Give each person their own username and strong password. Do not share credentials.</div><form id="user-form" class="grid2"><div class="field"><label>Username</label><input id="new-username" required minlength="3"></div><div class="field"><label>Temporary Password (12+ characters)</label><input id="new-password" required minlength="12"></div><div class="field"><label>Role</label><select id="new-role"><option value="CRANE">Crane operator</option><option value="DEPARTMENT">Department user</option><option value="ADMIN">Administrator</option></select></div><div class="field"><label>Scope</label><select id="new-scope"></select></div><button class="btn red">Create User</button></form><div class="table-wrap" style="margin-top:12px"><table><thead><tr><th>Username</th><th>Role</th><th>Scope</th><th>Status</th><th>Action</th></tr></thead><tbody id="users-body"></tbody></table></div></section>
<section class="panel hidden" id="history-panel"><div class="panel-head">Movement History <button class="btn gray" id="close-history">Close</button></div><div class="table-wrap"><table><thead><tr><th>Time</th><th>Coil</th><th>Action</th><th>From</th><th>To</th><th>User</th></tr></thead><tbody id="history-body"></tbody></table></div></section>
</main>
<div id="cell-modal" class="modal hidden"><div class="modal-card"><div class="panel-head">Assign Registered Coil to Yard Cell <button class="btn gray" id="close-cell">Close</button></div><div class="field"><label>Cell</label><input id="modal-cell" readonly></div><div class="field"><label>Registered Coil</label><select id="modal-coil"></select></div><div class="field"><label>Layer</label><select id="modal-layer"><option value="1">Layer 1 (Base)</option><option value="2">Layer 2 (Saddle)</option><option value="3">Layer 3 (Peak)</option></select></div><button class="btn green" id="save-cell">Save Location</button></div></div>
<script>
const $=id=>document.getElementById(id);
let me=null, config=null, coils=[], saddles=[], transfers=[], activeYard='CGL AREA', activeLayer='ALL', selectedCell=null;
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
async function api(url,opts={}){const r=await fetch(url,{credentials:'same-origin',headers:{'Content-Type':'application/json',...(opts.headers||{})},...opts});if(!r.ok){let d={};try{d=await r.json()}catch{}throw new Error(d.error||`Request failed (${r.status})`)}if(r.status===204)return null;const ct=r.headers.get('content-type')||'';return ct.includes('application/json')?r.json():r}
function say(s){$('search-result').textContent=s;setTimeout(()=>{if($('search-result').textContent===s)$('search-result').textContent=''},7000)}
function canEdit(){return me&&(me.role==='ADMIN'||me.role==='CRANE'||me.role==='DEPARTMENT')}
async function login(e){e.preventDefault();$('login-error').textContent='';try{const d=await api('/api/login',{method:'POST',body:JSON.stringify({username:$('login-username').value,password:$('login-password').value})});me=d.user;await initApp()}catch(e){$('login-error').textContent=e.message}}
async function initApp(){ $('login-overlay').classList.add('hidden');$('whoami').textContent=`${me.username} · ${me.role}${me.scope&&me.scope!=='*'?' · '+me.scope:''}`;$('admin-panel').classList.toggle('hidden',me.role!=='ADMIN');$('btn-history').classList.remove('hidden');$('btn-export').classList.remove('hidden');try{config=await api('/api/config');fillOptions();await refreshAll();if(me.role==='ADMIN')await loadUsers()}catch(e){say(e.message)}}
function fillOptions(){const areaOpts=[...new Set([...config.departments,...config.yards,...config.entries])];$('coil-area').innerHTML='<option value="">Select area (optional)</option>'+areaOpts.map(x=>`<option>${esc(x)}</option>`).join('');$('req-destination').innerHTML=config.entries.map(x=>`<option>${esc(x)}</option>`).join('');$('saddle-dept').innerHTML=config.saddleDepartments.map(x=>`<option>${esc(x)}</option>`).join('');$('new-scope').innerHTML='<option value="*">All scopes (Admin)</option>'+Array.from({length:25},(_,i)=>`<option>CRANE ${i+1}</option>`).join('')+config.departments.map(x=>`<option>${esc(x)}</option>`).join('');$('yard-tabs').innerHTML=config.yards.map(x=>`<button class="yard-tab ${x===activeYard?'active':''}" data-yard="${esc(x)}">${esc(x)}</button>`).join('')}
async function refreshAll(){const [c,s,t]=await Promise.all([api('/api/coils'),api('/api/saddles'),api('/api/transfers')]);coils=c;saddles=s;transfers=t;renderInventory();renderSaddles();renderTransfers();renderYard()}
function renderInventory(){ $('coil-count').textContent=`${coils.length} coils`;const rows=coils.map(c=>`<tr><td><strong>${esc(c.coil_no)}</strong></td><td>${esc(c.current_area||'—')}</td><td>${esc(c.current_location||'—')}</td><td>${c.layer||'—'}</td><td>${esc(c.status)}</td><td>${esc(c.updated_at||c.created_at||'')}</td><td><button class="btn blue" data-edit="${c.id}">Edit</button></td></tr>`);$('inventory-body').innerHTML=rows.join('')||'<tr><td colspan="7" class="muted">No coils registered yet.</td></tr>'; }
function renderSaddles(){const dept=$('saddle-dept').value;const rows=[['p1','Pit 1'],['p2','Pit 2']].map(([pit,label])=>`<div class="panel" style="margin:0;padding:10px"><div class="panel-head">${label}</div>${[0,1,2].map(pos=>{const item=saddles.find(s=>s.department===dept&&s.pit_key===pit&&s.position_index===pos);return `<div class="field"><label>Position ${pos+1}</label><div class="row"><input id="s-${pit}-${pos}" value="${esc(item?.coil_no||'')}" placeholder="Empty position"><button class="btn green" data-saddle="${pit}:${pos}">Save</button></div></div>`}).join('')}</div>`).join('');$('saddle-slots').innerHTML=rows}
function renderTransfers(){const list=transfers.map(t=>`<div class="task"><div><strong>COIL: ${esc(t.coil_no)}</strong><div class="small">From: ${esc(t.from_area||'—')} ${esc(t.from_location||'')}</div><div class="small">To: ${esc(t.to_area)} · Status: ${esc(t.status)}</div></div><div class="row" style="flex:0 1 auto">${t.status==='PENDING_CRANE'&&(me.role==='ADMIN'||me.role==='CRANE')?`<button class="btn green" data-complete="${t.id}">Complete Transfer</button>`:''}${t.status==='PENDING_CONFIRMATION'?`<button class="btn purple" data-confirm="${t.id}">Confirm Arrival</button>`:''}</div></div>`).join('');$('transfer-list').innerHTML=list||'<p class="muted">No active transfer requests.</p>'}
function pattern(cell,l){const col=cell.charAt(0),row=cell.slice(1);return l===1?cell:l===2?`${col}${row}${String.fromCharCode(col.charCodeAt(0)+1)}${row}`:`${col}${row}${String.fromCharCode(col.charCodeAt(0)+1)}${row}${String.fromCharCode(col.charCodeAt(0)+2)}${row}`}
function renderYard(){const rows=[];rows.push('<div class="grid-header"></div>'+config.columns.map(c=>`<div class="grid-header">${c}</div>`).join(''));let count=0;for(const r of config.rows){rows.push(`<div class="row-label">${r}</div>`);for(const col of config.columns){const cell=col+r;const items=coils.filter(c=>c.current_area===activeYard&&c.current_location===cell);const item=activeLayer==='ALL'?items[items.length-1]:items.find(c=>Number(c.layer)===Number(activeLayer));if(item)count++;rows.push(`<div class="cell ${item?'occupied':''}" data-cell="${cell}"><div class="cell-id">${item?esc(pattern(cell,Number(item.layer)||1)):esc(activeLayer==='ALL'?cell:pattern(cell,Number(activeLayer)))}</div><div class="cell-content">${item?esc(item.coil_no):'<span style="color:#ccc">Empty</span>'}</div><div class="small">${item?`L${item.layer||1}`:''}</div></div>`)}}
$('yard-grid').innerHTML=rows.join('');$('yard-count').textContent=`${count} shown in ${activeYard}`}
async function loadUsers(){const us=await api('/api/users');$('users-body').innerHTML=us.map(u=>`<tr><td>${esc(u.username)}</td><td>${esc(u.role)}</td><td>${esc(u.scope)}</td><td>${u.active?'Active':'Disabled'}</td><td><button class="btn ${u.active?'gray':'green'}" data-toggle-user="${u.id}" data-active="${u.active?0:1}">${u.active?'Disable':'Enable'}</button></td></tr>`).join('')}
async function registerCoil(e){e.preventDefault();try{await api('/api/coils',{method:'POST',body:JSON.stringify({coil_no:$('coil-no').value,current_area:$('coil-area').value,current_location:$('coil-location').value,notes:$('coil-notes').value})});$('coil-form').reset();await refreshAll();say('Coil registered and saved to the server database.')}catch(e){say(e.message)}}
async function transferRequest(e){e.preventDefault();try{await api('/api/transfers',{method:'POST',body:JSON.stringify({coil_no:$('req-coil').value,to_area:$('req-destination').value})});$('transfer-form').reset();await refreshAll();say('Transfer request dispatched.')}catch(e){say(e.message)}}
async function saveSaddle(pit,pos){const dept=$('saddle-dept').value;try{await api(`/api/saddles/${encodeURIComponent(dept)}/${pit}/${pos}`,{method:'PUT',body:JSON.stringify({coil_no:$(`s-${pit}-${pos}`).value})});await refreshAll();say('Saddle position saved.')}catch(e){say(e.message)}}
function openCell(cell){selectedCell=cell;$('modal-cell').value=`${activeYard} / ${cell}`;$('modal-coil').innerHTML='<option value="">Choose a registered coil</option>'+coils.filter(c=>!c.current_location||c.current_area!==activeYard||c.current_location!==cell).map(c=>`<option value="${c.id}">${esc(c.coil_no)} · ${esc(c.current_area||'Unassigned')} / ${esc(c.current_location||'')}</option>`).join('');$('cell-modal').classList.remove('hidden')}
async function saveCell(){const id=Number($('modal-coil').value),layer=Number($('modal-layer').value);const c=coils.find(x=>x.id===id);if(!c){say('Select a registered coil.');return}try{await api(`/api/coils/${id}`,{method:'PATCH',body:JSON.stringify({current_area:activeYard,current_location:selectedCell,layer,status:'IN_YARD'})});$('cell-modal').classList.add('hidden');await refreshAll();say(`${c.coil_no} location saved.`)}catch(e){say(e.message)}}
async function search(){const q=$('search-coil').value.trim();if(!q){say('Please enter a coil number.');return}try{const found=await api('/api/coils?q='+encodeURIComponent(q));if(!found.length){say(`Coil ${q} not found.`);return}const c=found.find(x=>x.coil_no.toUpperCase()===q.toUpperCase())||found[0];say(`FOUND: ${c.coil_no} → ${c.current_area||'Unassigned'} / ${c.current_location||'No location'} (${c.status})`);if(config.yards.includes(c.current_area)){activeYard=c.current_area;document.querySelectorAll('[data-yard]').forEach(b=>b.classList.toggle('active',b.dataset.yard===activeYard));renderYard()}}catch(e){say(e.message)}}
async function showHistory(){try{const h=await api('/api/movements');$('history-body').innerHTML=h.map(m=>`<tr><td>${esc(m.performed_at)}</td><td>${esc(m.coil_no)}</td><td>${esc(m.action)}</td><td>${esc((m.from_area||'')+' '+(m.from_location||''))}</td><td>${esc((m.to_area||'')+' '+(m.to_location||''))}</td><td>${esc(m.username||'')}</td></tr>`).join('')||'<tr><td colspan="6">No history.</td></tr>';$('history-panel').classList.remove('hidden')}catch(e){say(e.message)}}
document.addEventListener('submit',e=>{if(e.target.id==='login-form')login(e);if(e.target.id==='coil-form')registerCoil(e);if(e.target.id==='transfer-form')transferRequest(e);if(e.target.id==='user-form')createUser(e)});
document.addEventListener('click',async e=>{const b=e.target.closest('button,[data-cell]');if(!b)return;try{
if(b.dataset.yard){activeYard=b.dataset.yard;document.querySelectorAll('[data-yard]').forEach(x=>x.classList.toggle('active',x===b));renderYard()}
else if(b.dataset.layer){activeLayer=b.dataset.layer;document.querySelectorAll('[data-layer]').forEach(x=>x.classList.toggle('active',x===b));renderYard()}
else if(b.dataset.saddle){const [pit,pos]=b.dataset.saddle.split(':');await saveSaddle(pit,Number(pos))}
else if(b.dataset.complete){await api(`/api/transfers/${b.dataset.complete}/complete`,{method:'POST',body:'{}'});await refreshAll();say('Transfer marked delivered; awaiting destination confirmation.')}
else if(b.dataset.confirm){await api(`/api/transfers/${b.dataset.confirm}/confirm`,{method:'POST',body:'{}'});await refreshAll();say('Arrival confirmed.')}
else if(b.dataset.cell){openCell(b.dataset.cell)}
else if(b.dataset.edit){const c=coils.find(x=>x.id===Number(b.dataset.edit));if(c){const area=prompt('Current area / department:',c.current_area||'');if(area===null)return;const loc=prompt('Current location:',c.current_location||'');if(loc===null)return;const layer=prompt('Layer (1, 2, 3 or blank):',c.layer||'');if(layer===null)return;await api(`/api/coils/${c.id}`,{method:'PATCH',body:JSON.stringify({current_area:area,current_location:loc,layer:layer||null,status:c.status})});await refreshAll();say('Coil details updated.')}}
else if(b.dataset.toggleUser){await api(`/api/users/${b.dataset.toggleUser}`,{method:'PATCH',body:JSON.stringify({active:b.dataset.active==='1'})});await loadUsers()}
}catch(err){say(err.message)}});
async function createUser(e){e.preventDefault();try{const role=$('new-role').value;let scope=$('new-scope').value;if(role==='ADMIN')scope='*';if(role==='CRANE'&&!/^CRANE (?:[1-9]|1\d|2[0-5])$/.test(scope))throw new Error('Choose CRANE 1 through CRANE 25.');await api('/api/users',{method:'POST',body:JSON.stringify({username:$('new-username').value,password:$('new-password').value,role,scope})});$('user-form').reset();await loadUsers();say('User account created.')}catch(err){say(err.message)}}
